# Copy this file to .env for local Docker runs.
# Never commit real production credentials to GitHub.
SERVER_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/payment_gateway
DB_USERNAME=payment_user
DB_PASSWORD=change-me-local-only
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TYPE=simple
PAYMENT_GATEWAY_MODE=UAT
PAYMENT_GATEWAY_MID=DEMO_MERCHANT_001
PAYMENT_GATEWAY_ENC_KEY=0123456789abcdef0123456789abcdef
PAYMENT_GATEWAY_UAT_URL=https://uat-provider.example.com/paymentrequest/seamless
PAYMENT_GATEWAY_PROD_URL=https://provider.example.com/paymentrequest/seamless
MERCHANT_CALLBACK_URL=http://localhost:8080/api/v1/payments/callback
PAYMENT_CONNECT_TIMEOUT_MS=5000
PAYMENT_READ_TIMEOUT_MS=15000
CALLBACK_REPLAY_WINDOW_MINUTES=5
STALE_PAYMENT_MINUTES=15
RECONCILIATION_CRON=0 */10 * * * *
RATE_LIMIT_PER_MINUTE=120
DDL_AUTO=validate
